# Copy to .env and fill in. .env is gitignored and must never be committed.
# See docs/RISK.md section 4.

# Where the bar store lives. Defaults to ./data
AIFIN_DATA_DIR=./data

# Execution mode: backtest | paper | live. Defaults to paper.
# `live` is not implemented until Phase 5 and requires the keys below.
AIFIN_MODE=paper

# Phase 5 only. Trade permission ONLY. Withdrawals disabled. IP whitelisted.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
