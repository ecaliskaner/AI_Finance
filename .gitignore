# Secrets — never commit. See docs/RISK.md §4.
.env
.env.*
!.env.example
*.key
*.pem
/secrets/

# Data — large, regenerable, never versioned
# Anchored to repo root: an unanchored "data/" also matches ai_finance/data/,
# the source package, and silently excludes it from version control.
/data/
*.parquet
*.duckdb

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Research output
/runs/
/artifacts/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
